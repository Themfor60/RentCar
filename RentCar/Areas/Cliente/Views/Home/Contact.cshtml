 <!-- Contact Start -->
<div class="container-fluid py-5">
    <div class="container pt-1 pb-3">
        <h1 class="text-center mb-4">Contáctanos</h1>
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-body p-5 bg-light">
                        <form>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <input type="text" class="form-control p-3" placeholder="Nombre" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <input type="email" class="form-control p-3" placeholder="Correo" required>
                                </div>
                            </div>
                            <div class="mb-3">
                                <input type="text" class="form-control p-3" placeholder="Asunto" required>
                            </div>
                            <div class="mb-4">
                                <textarea class="form-control p-3" rows="5" placeholder="Mensaje" required></textarea>
                            </div>
                            <div class="text-center">
                                <button class="btn btn-primary px-5 py-3" type="submit">Enviar</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="row mt-5">
            <div class="col-lg-5 mx-auto">
                <div class="bg-secondary d-flex flex-column justify-content-center px-5 py-4 rounded-4 text-light">
                    <div class="d-flex mb-3">
                        <i class="fa fa-2x fa-map-marker-alt text-primary me-3"></i>
                        <div>
                            <h5 class="text-light">Oficina Principal</h5>
                            <p class="mb-0">Calle Central #10, Lucerna, Santo Domingo Este</p>
                        </div>
                    </div>
                    <div class="d-flex mb-3">
                        <i class="fa fa-2x fa-envelope-open text-primary me-3"></i>
                        <div>
                            <h5 class="text-light">Servicio al Cliente</h5>
                            <p class="mb-0">servicioalcliente@lucernarentcar.com</p>
                        </div>
                    </div>
                    <div class="d-flex">
                        <i class="fa fa-2x fa-exchange-alt text-primary me-3"></i>
                        <div>
                            <h5 class="text-light">Devoluciones y Reembolsos</h5>
                            <p class="mb-0">refund@lucernarentcar.com</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Contact End -->
